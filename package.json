{
  "name": "avaliamais-tycoon",
  "version": "1.0.0",
  "description": "Avalia+ Tycoon da Educação - Simulador de gestão escolar",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.3.0",
"vite": "~5.0.0"
  },
  "build": {
    "appId": "com.avaliamais.tycoon",
    "productName": "Avalia+ Tycoon",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis", "signAndEditExecutable": false }
  }
}
